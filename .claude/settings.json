{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 agentic/runtime/hooks/session_start_check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 agentic/runtime/hooks/pretooluse_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
