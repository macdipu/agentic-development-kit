{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "evidence",
    "blocking_issues",
    "open_questions",
    "recommended_next_step",
    "outputs"
  ],
  "properties": {
    "status": {
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED",
        "PREVIEW_READY"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_step": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "READY",
              "PREVIEW_READY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "blocking_issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "blocking_issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
