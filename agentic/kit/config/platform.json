{
  "context_strategy": "context-first-incremental",
  "input_modes": [
    "prompt-first",
    "document-first"
  ],
  "full_brownfield_audit": "only_when_no_usable_baseline",
  "max_agent_retries": 2,
  "audit_tool_calls": true,
  "direct_production_write": false,
  "require_release_approval": true,
  "record_task_timing": true,
  "max_task_seconds": 900,
  "max_tool_calls_per_task": 50,
  "require_uat_approval": false,
  "skill_budgets": {
    "implementation-agent": {
      "max_task_seconds": 7200,
      "max_agent_retries": 4
    },
    "automated-qa-agent": {
      "max_task_seconds": 3600,
      "max_agent_retries": 3
    },
    "code-review-agent": {
      "max_task_seconds": 1800
    },
    "device-preview-agent": {
      "max_task_seconds": 1800
    },
    "web-preview-agent": {
      "max_task_seconds": 1800
    }
  },
  "post_hoc_threshold_seconds": 10,
  "require_task_for_code_writes": true
}
